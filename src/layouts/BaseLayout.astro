---
import SiteNav from '../components/SiteNav.astro';
import MotionRuntime from '../components/MotionRuntime.astro';
import CustomCursor from '../components/CustomCursor.astro';
import GrainOverlay from '../components/GrainOverlay.astro';
import VercelMetrics from '../components/VercelMetrics.astro';
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** Alt text for the social card itself; defaults to a description of the portfolio card. */
  ogImageAlt?: string;
}

const {
  title,
  description,
  ogImage = '/og-image.png',
  ogImageAlt = "Ugnius Liberman - designer and developer, portfolio and journal, on a paper-white field with a pink accent",
} = Astro.props;
// `site` is set in astro.config.mjs, but Astro types it as optional. Falling back
// to the request URL keeps the build safe if that config ever regresses.
const siteUrl = Astro.site ?? new URL(Astro.url);
const canonical = new URL(Astro.url.pathname, siteUrl);
const ogImageUrl = new URL(ogImage, siteUrl);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#030303" />
    <link
      rel="preload"
      href="/fonts/archivo-black-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <!-- Every shipped social card is a 1200x630 PNG, the generic fallback included. -->
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebSite',
          name: site.name,
          url: siteUrl.href,
          description: site.description,
        },
        {
          '@type': 'Person',
          name: site.name,
          jobTitle: site.title,
          description: site.description,
          url: siteUrl.href,
          sameAs: site.socials.map((social) => social.href),
        },
      ],
    })}>
    </script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <script>import '../scripts/hash-scroll';</script>
    <SiteNav />
    <slot />
    <MotionRuntime />
    <CustomCursor />
    <GrainOverlay />
    <VercelMetrics />
    <script>import '../scripts/text-scramble';</script>
  </body>
</html>
