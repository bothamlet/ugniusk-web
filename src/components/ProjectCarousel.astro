---
import type { SelectedWorkCard } from '../data/projects';
import ProjectCardVisual from './ProjectCardVisual.astro';

interface Props {
  cards: SelectedWorkCard[];
}

const { cards } = Astro.props;
---

<section id="work" class="selected-work" aria-labelledby="selected-work-title">
  <header class="selected-work__header">
    <h2 id="selected-work-title" class="selected-work__title" data-scramble="scroll">Selected Work</h2>
  </header>

  <div class="selected-work__grid">
    {
      cards.map((card) => {
        // A planned entry has no project page, so it renders as a plain div: no
        // href and no focus stop, while keeping the shared card hover effect.
        const Card = card.planned ? 'div' : 'a';
        return (
          <article class:list={["selected-work__item", card.planned && "selected-work__item--planned"]}>
            <Card
              class:list={["selected-work__link", !card.planned && "cursor-hover"]}
              href={card.planned ? undefined : `/projects/${card.slug}/`}
            >
              <ProjectCardVisual project={card} />
              <span class="selected-work__meta">
                <span class="selected-work__name-row">
                  <strong class="selected-work__name" data-scramble="scroll">{card.title}</strong>
                  {card.planned && <em class="selected-work__planned">Planned</em>}
                </span>
                <span class="selected-work__label-row">
                  <span class="selected-work__descriptor">{card.label}</span>
                  <span class="selected-work__year" data-scramble="scroll">{card.year}</span>
                </span>
              </span>
            </Card>
          </article>
        );
      })
    }
  </div>
</section>

<style>
  .selected-work {
    position: relative;
    overflow: hidden;
    background: var(--color-cream);
    color: #030303;
    padding:
      clamp(4rem, 8vw, 8rem)
      clamp(1.5rem, 4vw, 4rem)
      clamp(5rem, 10vw, 9rem);
  }

  .selected-work__header {
    width: min(100%, 120rem);
    margin-inline: auto;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .selected-work__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .selected-work__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    width: min(100%, 120rem);
    margin-inline: auto;
  }

  .selected-work__item {
    width: 100%;
    transition: scale 500ms cubic-bezier(0.16, 0.8, 0.2, 1);
  }

  /* Every card reacts to hover, linked or not: the planned card only lacks the
     link, not the affordance. */
  .selected-work__item:hover {
    scale: 0.97;
  }

  .selected-work__item:nth-child(odd):last-child {
    grid-column: 1;
  }

  .selected-work__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .selected-work__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 0.5rem;
  }

  .selected-work__visual,
  .product-shot,
  .selected-work__visual-fallback {
    position: relative;
    display: flex;
    align-items: flex-end;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 1rem;
  }

  .selected-work__item:hover :global(.product-shot__ghost) {
    opacity: 1;
    transform: scale(1);
  }

  .selected-work__item:hover :global(.product-shot__img) {
    opacity: 0.4;
  }

  .selected-work__visual-fallback {
    background: #030303;
  }

  /* Two fixed rows per card: name, then label and year. Each row owns its font
     size, so no card is patched to fit - a long title wraps onto a second line
     instead of shrinking. */
  .selected-work__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.2rem;
    margin-top: 1rem;
    padding-inline: 0.125rem;
  }

  .selected-work__name-row {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    width: 100%;
  }

  .selected-work__name {
    min-width: 0;
    color: #030303;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  /* Label, then the year at the far end. The gap is the minimum separation if a
     long label ever reaches the year. */
  .selected-work__label-row {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    width: 100%;
    margin-top: 0.45rem;
    letter-spacing: 0.06em;
  }

  /* One-line classification for the card, in the metadata typeface one step up
     in size. The clamp is the guard for a future label that runs long: it
     truncates at two lines rather than wrapping the year out of the row. */
  .selected-work__descriptor {
    display: -webkit-box;
    min-width: 0;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    min-height: 1.5em;
    color: #6f6a64;
    font-family: var(--font-mono);
    font-size: 1.025rem;
    line-height: 1.5;
  }

  /* The planned card's label is a short phrase that only needs a third line at
     the narrowest width, so it keeps the shared type and drops the clamp: the
     whole descriptor stays visible instead of being cut at two lines. */
  .selected-work__item--planned .selected-work__descriptor {
    display: block;
    -webkit-line-clamp: unset;
    line-clamp: unset;
    overflow: visible;
  }

  .selected-work__year,
  .selected-work__planned {
    flex-shrink: 0;
    /* Pushed to the end of the row, then inset from the card edge. */
    margin-left: auto;
    margin-right: 0.5rem;
    color: #6f6a64;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 400;
    line-height: 1.2;
    white-space: nowrap;
  }

  .selected-work__planned {
    font-style: italic;
  }

  @media (min-width: 1200px) {
    .selected-work__descriptor,
    .selected-work__year,
    .selected-work__planned {
      font-family: var(--font-mono-desktop);
      letter-spacing: normal;
    }

    .selected-work__descriptor {
      font-size: clamp(1.025rem, 0.9vw, 1.125rem);
      letter-spacing: normal;
    }
  }

  @media (max-width: 767px) {
    .selected-work__label-row {
      letter-spacing: normal;
    }

    .selected-work {
      padding-block: clamp(3rem, 6vw, 5rem) clamp(4rem, 8vw, 6rem);
    }

    .selected-work__grid {
      grid-template-columns: 1fr;
      gap: clamp(2.5rem, 6vw, 4rem);
    }

    .selected-work__item:nth-child(odd):last-child {
      grid-column: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .selected-work__item {
      transition-duration: 0.01ms;
    }
    .product-shot__ghost,
    .product-shot__img {
      transition-duration: 0.01ms;
    }
  }
</style>
