---
import { imageFor, imageSrcSet } from '../data/images';

interface Props {
	src?: string;
	alt: string;
	eager?: boolean;
	code: string;
	inset?: boolean;
}

const { src, alt, eager = false, code, inset = false } = Astro.props;

// The shipped asset's own pixels, read from the file, reserve layout space (no CLS).
const image = src ? imageFor(src) : undefined;
const width = image?.width ?? 1920;
const height = image?.height ?? 1080;
const srcSet = src ? imageSrcSet(src) : undefined;
// A full-bleed band is the viewport; the inset variant is 80% of it, capped at 64rem.
const sizes = inset ? '(min-width: 80rem) 64rem, 80vw' : '100vw';
---

<div class:list={["project-visual-full", { "project-visual-full--inset": inset }]}>
  <div class="project-visual-inner">
    {src ? (
      <a class="project-visual-image cursor-hover" href={src} target="_blank" rel="noopener noreferrer" aria-label={`Open original image: ${alt}`}>
        <img
          src={src}
          srcset={srcSet}
          sizes={srcSet ? sizes : undefined}
          alt={alt}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : undefined}
          decoding="async"
          width={width}
          height={height}
        />
      </a>
    ) : (
      <div class="project-visual-placeholder">
        <span class="project-visual-code">{code}</span>
      </div>
    )}
  </div>
</div>

<style>
  /* SECOND VIEW - full-bleed visual */
  .project-visual-full {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    /* Hairlines top and bottom so a full-bleed visual reads as a framed band.
       Without them a visual with its own margins is just white space. */
    border-top: 1px solid rgb(7 7 7 / 0.18);
    border-bottom: 1px solid rgb(7 7 7 / 0.18);
  }

  .project-visual-inner {
    display: flex;
    flex-direction: column;
  }

  .project-visual-image {
    display: block;
    position: relative;
    width: 100%;
    line-height: 0;
  }

  .project-visual-full--inset .project-visual-image {
    width: 80%;
    max-width: 64rem;
    margin-inline: auto;
  }

  /* Today's Brief's inset visual is a newspaper page whose paper edge samples to
     #fdfbf7. Painting the band that tone carries the page into the exposed side
     gutters instead of framing it in the page white. Only the inset variant is
     tinted; every other visual keeps the band transparent. */
  .project-visual-full--inset {
    background: #fdfbf7;
  }

  .project-visual-image:focus-visible {
    outline: 3px solid var(--color-accent-deep);
    outline-offset: -3px;
  }

  .project-visual-image img {
    display: block;
    width: 100%;
    height: auto;
  }

  .project-visual-placeholder {
    position: relative;
    width: 100%;
    min-height: clamp(26rem, 45vw, 42rem);
    background:
      radial-gradient(circle at 48% 37%, rgb(124 58 237 / 0.12), transparent 22%),
      linear-gradient(145deg, #f5f3ef 0%, #e8e4de 55%, #f0ece6 100%);
  }

  .project-visual-placeholder::after {
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 140 140' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.82' numOctaves='4'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.65'/%3E%3C/svg%3E");
    content: '';
    opacity: 0.06;
  }

  .project-visual-code {
    position: absolute;
    top: 1.25rem;
    left: 1.5rem;
    z-index: 1;
    color: #07070725;
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.2em;
  }
</style>
