---
import SocialIcon from './SocialIcon.astro';

interface SocialLink {
  label: string;
  href: string;
}

interface Props {
  name: string;
  socials: readonly SocialLink[];
}

const { name, socials } = Astro.props;
---

<footer class="site-footer" role="contentinfo" aria-label="Site footer">
  <div class="site-footer__top">
    <h2 class="site-footer__headline" data-scramble="scroll">Find me.</h2>

    <div class="site-footer__socials">
      {socials.map((link, i) => (
        <Fragment>
          {i > 0 && <span class="site-footer__dot" aria-hidden="true">·</span>}
          <a class="site-footer__social-link cursor-hover" href={link.href} target="_blank" rel="noreferrer">
            <SocialIcon label={link.label} size={18} />
            <span data-scramble="scroll">{link.label}</span>
          </a>
        </Fragment>
      ))}
    </div>
  </div>

  <div class="site-footer__meta">
    <span>&copy; 2026 {name}</span>
  </div>

  <div class="site-footer__brand" aria-hidden="true">
    <div class="site-footer__brand-track">
      <span class="site-footer__brand-name"><span>Ugnius</span> <span class="accent">Liberman</span></span>
      <span class="site-footer__brand-name"><span>Ugnius</span> <span class="accent">Liberman</span></span>
      <span class="site-footer__brand-name"><span>Ugnius</span> <span class="accent">Liberman</span></span>
      <span class="site-footer__brand-name"><span>Ugnius</span> <span class="accent">Liberman</span></span>
    </div>
  </div>
</footer>

<script>
  // Keep the off-screen ticker idle; only its transform animates while visible.
  const observer = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      entry.target.classList.toggle('site-footer__brand--visible', entry.isIntersecting);
    }
  });
  document.querySelectorAll('.site-footer__brand').forEach(brand => observer.observe(brand));
</script>

<style>
  .site-footer {
    position: relative;
    z-index: 1;
    overflow: hidden;
    background: #08090a;
    color: #f4f3f0;
    padding:
      clamp(3rem, 6vw, 5rem)
      clamp(1.5rem, 4vw, 4rem)
      clamp(1rem, 2vw, 2rem);
  }

  .site-footer__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: min(100%, 120rem);
    margin-inline: auto;
    padding-bottom: clamp(2rem, 4vw, 3rem);
    gap: 2rem;
  }

  .site-footer__headline {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 0.95;
    text-transform: uppercase;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .site-footer__socials {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .site-footer__dot {
    color: rgb(255 255 255 / 0.3);
    font-size: 1.2rem;
  }

  .site-footer__social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #f4f3f0;
    font-family: var(--font-reading);
    font-size: clamp(1.1rem, 1.5vw, 1.4rem);
    text-decoration: none;
    white-space: nowrap;
    transition: color 200ms ease-out;
  }

  .site-footer__social-link:hover,
  .site-footer__social-link:focus-visible {
    color: var(--color-accent-soft);
  }

  .site-footer__social-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  /* The icon comes from SocialIcon, so its own size lives on the SVG; this only
     stops the flex row from squeezing it. */
  .site-footer__social-link :global(svg) {
    flex-shrink: 0;
  }

  .site-footer__meta {
    width: min(100%, 120rem);
    margin-inline: auto;
    padding: clamp(1.5rem, 3vw, 2rem) 0;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    font-family: Arial, Helvetica, sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    color: rgb(255 255 255 / 0.6);
    text-transform: uppercase;
  }

  .site-footer__brand {
    contain: paint;
    width: 100vw;
    margin-left: calc(-1 * clamp(1.5rem, 4vw, 4rem));
    overflow: hidden;
    line-height: 0.78;
    margin-top: clamp(0.75rem, 1.5vw, 1.5rem);
  }

  .site-footer__brand-track {
    display: flex;
    width: max-content;
    animation: marquee 12s linear infinite;
    animation-play-state: paused;
    backface-visibility: hidden;
  }

  .site-footer__brand--visible .site-footer__brand-track {
    animation-play-state: running;
    will-change: transform;
  }

  .site-footer__brand-name {
    flex-shrink: 0;
    padding-right: 0.3em;
    font-family: var(--font-display);
    font-size: clamp(3rem, 9vw, 13rem);
    font-weight: 900;
    letter-spacing: -0.06em;
    line-height: 0.82;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .site-footer__brand-name .accent {
    color: var(--color-accent);
  }

  @keyframes marquee {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(-50%, 0, 0); }
  }

  @media (scripting: none) {
    .site-footer__brand-track {
      animation-play-state: running;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer__brand-track {
      animation: none;
    }
  }

  @media (max-width: 767px) {
    .site-footer__top {
      flex-direction: column;
      gap: 1.5rem;
    }

    .site-footer__headline {
      font-size: clamp(2.5rem, 12vw, 4rem);
    }

    .site-footer__socials {
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
      gap: 0.75rem 1rem;
    }

    .site-footer__social-link {
      min-height: 2.75rem;
    }

    .site-footer__dot {
      display: none;
    }

    .site-footer__meta {
      text-align: center;
    }

  }

  @media (max-width: 767px), (pointer: coarse) {
    .site-footer__brand--visible .site-footer__brand-track,
    .site-footer__brand-track {
      animation: none;
      will-change: auto;
      font-size: clamp(3rem, 9vw, 13rem);
      transform: translate3d(-2.8em, 0, 0);
    }

    .site-footer__brand-name:nth-child(n + 3) {
      display: none;
    }
  }
</style>
