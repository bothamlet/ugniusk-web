---
interface SocialLink {
  label: string;
  href: string;
}

interface Props {
  links: readonly SocialLink[];
}

const { links } = Astro.props;
---

<nav aria-label="Social links">
  <ul class="flex items-center justify-end gap-4">
    {
      links.map((link) => (
        <li>
          <a
            class="cursor-hover group flex size-8 items-center justify-center text-white/25 transition-[color,transform] duration-200 ease-out hover:scale-[1.15] hover:text-accent focus-visible:scale-[1.15] focus-visible:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
            href={link.href}
            target="_blank"
            rel="noreferrer"
            aria-label={link.label}
          >
            {
              link.label === 'GitHub' && (
                <svg class="size-[17px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 .7A11.5 11.5 0 0 0 8.36 23.1c.58.1.79-.25.79-.56v-2.23c-3.23.7-3.91-1.37-3.91-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.77 2.72 1.26 3.38.96.1-.75.41-1.26.74-1.55-2.58-.29-5.29-1.29-5.29-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.47.11-3.05 0 0 .97-.31 3.16 1.18a10.95 10.95 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.72 5.39-5.31 5.68.42.36.79 1.07.79 2.16v3.25c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z" />
                </svg>
              )
            }
            {
              link.label === 'LinkedIn' && (
                <svg class="size-[17px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M5.37 7.98H1.64V22h3.73V7.98ZM3.51 2A2.18 2.18 0 1 0 3.5 6.36 2.18 2.18 0 0 0 3.51 2ZM22.36 13.96c0-4.23-2.26-6.2-5.28-6.2a4.55 4.55 0 0 0-4.12 2.27V7.98H9.23V22h3.73v-6.94c0-1.83.35-3.61 2.62-3.61 2.24 0 2.27 2.1 2.27 3.73V22h3.73l.78-8.04Z" />
                </svg>
              )
            }
            {
              link.label === 'Instagram' && (
                <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4.25" />
                  <circle cx="17.45" cy="6.65" r="1" fill="currentColor" stroke="none" />
                </svg>
              )
            }
            <span class="sr-only">{link.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
