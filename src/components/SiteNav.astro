---
// Site navbar - fixed, condensed, difference blend mode
// Hidden on hero, appears after scrolling past it
---

<nav class="site-nav" aria-label="Main navigation">
  <a class="site-nav__brand" href="/#top">Ugnius <span class="site-nav__surname">Liberman</span></a>
  <ul class="site-nav__links">
    <li><a class="site-nav__link" href="/#about">About</a></li>
    <li><a class="site-nav__link" href="/#work" aria-label="Selected Work"><span class="site-nav__selected">Selected </span>Work</a></li>
  </ul>
</nav>

<script>import '../scripts/site-nav';
</script>
<style>
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: clamp(0.75rem, 2vw, 1rem) clamp(1rem, 3vw, 2rem);
    mix-blend-mode: difference;
    pointer-events: none;
    opacity: 0;
    transition: opacity 400ms ease;
  }

  .site-nav--visible,
  .site-nav:focus-within {
    opacity: 1;
  }

  .site-nav--visible .site-nav__brand,
  .site-nav--visible .site-nav__links,
  .site-nav:focus-within .site-nav__brand,
  .site-nav:focus-within .site-nav__links {
    pointer-events: auto;
  }

  .site-nav__brand {
    font-family: var(--font-display);
    font-size: clamp(0.8rem, 1vw, 0.95rem);
    font-weight: 900;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #fff;
    text-decoration: none;
    line-height: 1;
  }

  .site-nav__surname {
    color: #fff;
  }

  .site-nav__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: clamp(1rem, 2.5vw, 2.5rem);
  }

  .site-nav__link {
    font-family: var(--font-mono);
    font-size: clamp(0.8rem, 0.95vw, 0.9rem);
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    text-decoration: none;
    line-height: 1;
    transition: opacity 200ms ease;
  }

  .site-nav__link:hover {
    opacity: 0.6;
  }

  .site-nav a:focus-visible {
    outline: 2px solid var(--color-accent-soft);
    outline-offset: 3px;
  }

  @media (min-width: 1200px) {
    .site-nav__link {
      font-family: var(--font-mono-desktop);
      font-size: clamp(0.9375rem, 0.8vw, 1.0625rem);
      letter-spacing: 0.01em;
    }
  }

  @media (max-width: 900px) {
    .site-nav {
      flex-wrap: wrap;
      gap: 0.25rem 0.5rem;
      padding: max(0.25rem, env(safe-area-inset-top)) 0.75rem 0.25rem;
      mix-blend-mode: normal;
      background: rgba(3, 3, 3, 0.94);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }

    .site-nav__brand {
      display: flex;
      column-gap: 0.25em;
      align-items: center;
      min-height: 2.75rem;
      flex: 1 1 5rem;
      min-width: min-content;
      font-size: 0.75rem;
      line-height: 1.15;
    }

    .site-nav__links {
      flex: 1 0 auto;
      justify-content: flex-end;
      gap: 0.25rem;
    }

    .site-nav__links li {
      flex: 1;
    }

    .site-nav__link {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 2.75rem;
      padding-inline: 0.375rem;
      font-size: 0.8125rem;
      line-height: 1.2;
      letter-spacing: 0.04em;
      white-space: nowrap;
    }

    .site-nav__selected {
      display: none;
    }
  }

  @media (pointer: coarse) {
    .site-nav {
      mix-blend-mode: normal;
      background: rgba(3, 3, 3, 0.85);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }
  }
</style>
