---
import HeroName from './HeroName.astro';
import SocialLinks from './SocialLinks.astro';

interface SocialLink {
  label: string;
  href: string;
}

interface Props {
  name: string;
  socials: readonly SocialLink[];
}

const { name, socials } = Astro.props;
const [firstName, ...lastNameParts] = name.split(' ');
const lastName = lastNameParts.join(' ');
---

<main class="hero-sticky" data-hero-fade>
  <section class="hero-frame relative mx-auto min-h-[100svh] max-w-[120rem] overflow-hidden" aria-label={`${name} portfolio introduction`}>
    <HeroName firstName={firstName} lastName={lastName} />

    <div class="absolute inset-x-0 bottom-0 z-20 flex justify-end px-5 pb-8 sm:px-8 lg:px-12">
      <SocialLinks links={socials} />
    </div>
  </section>
</main>

<style>
  .hero-sticky {
    position: sticky;
    top: 0;
    z-index: 0;
    min-height: 100svh;
    overflow: hidden;
    background: var(--color-ink);
  }

  .hero-frame::after {
    position: absolute;
    inset: 0;
    z-index: 10;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='1'/%3E%3C/svg%3E");
    content: "";
    opacity: 0.04;
    pointer-events: none;
  }

  @media (max-width: 767px) {
    .hero-frame {
      min-height: 44rem;
    }
  }
</style>
