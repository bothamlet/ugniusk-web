---
import HeroName from './HeroName.astro';
import SocialLinks from './SocialLinks.astro';

interface SocialLink {
  label: string;
  href: string;
}

interface Props {
  name: string;
  socials: readonly SocialLink[];
}

const { name, socials } = Astro.props;
const [firstName, ...lastNameParts] = name.split(' ');
const lastName = lastNameParts.join(' ');
---

<div class="hero-sticky">
  <section class="hero-frame" aria-label={`${name} portfolio introduction`}>
    <HeroName firstName={firstName} lastName={lastName} />

    <div class="hero-socials">
      <SocialLinks links={socials} />
    </div>
  </section>
</div>

<style>
  .hero-sticky {
    position: sticky;
    top: 0;
    z-index: 0;
    min-height: 100svh;
    overflow: hidden;
    background: var(--color-ink);
  }

  .hero-frame {
    position: relative;
    margin-inline: auto;
    min-height: 100svh;
    max-width: 120rem;
    overflow: hidden;
  }

  .hero-socials {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 20;
    display: flex;
    justify-content: flex-end;
    padding: 0 1.25rem 2rem;
  }

  @media (min-width: 640px) {
    .hero-socials {
      padding-inline: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .hero-socials {
      padding-inline: 3rem;
    }
  }

  .hero-frame::after {
    position: absolute;
    inset: 0;
    z-index: 10;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='1'/%3E%3C/svg%3E");
    content: "";
    opacity: 0.04;
    pointer-events: none;
  }

  @media (max-width: 767px) {
    .hero-frame {
      min-height: 44rem;
    }
  }
</style>
