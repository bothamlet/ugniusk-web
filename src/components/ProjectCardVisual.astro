---
import type { SelectedWorkCard } from '../data/projects';

// The card visual only reads these fields, so it accepts the planned card and the
// shipped projects alike.
type CardVisual = Pick<SelectedWorkCard, 'title' | 'cardImage' | 'image' | 'imageAlt'>;

interface Props {
  project: CardVisual;
}

const { project } = Astro.props;

// Cards may ship their own visual; otherwise they reuse the project photo.
const cardImage = project.cardImage ?? project.image;

// The card is ~600px wide, so the full 2560px asset is wasted on a phone. The two
// variants are generated once beside each asset; the full file stays as `src`.
const cardSrcSet = (src: string) =>
	`${src.replace(/\.webp$/, "-800.webp")} 800w, ${src.replace(/\.webp$/, "-1600.webp")} 1600w`;
---

{
  cardImage ? (
    <div class="product-shot" aria-hidden="true">
      <img
        class="product-shot__img"
        src={cardImage}
        srcset={cardSrcSet(cardImage)}
        sizes="(max-width: 767px) 92vw, 46vw"
        alt={project.imageAlt ?? `${project.title} - project visual`}
        loading="lazy"
        decoding="async"
        width="1920"
        height="1080"
      />
      <div class="product-shot__ghost">
        <img
          class="product-shot__ghost-img"
          src={cardImage}
          srcset={cardSrcSet(cardImage)}
          sizes="(max-width: 767px) 92vw, 46vw"
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
          width="1920"
          height="1080"
        />
      </div>
    </div>
  ) : (
    <span class="selected-work__visual-fallback" aria-hidden="true" />
  )
}

<style>
  .product-shot {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 1rem;
    background: #030303;
  }

  /* Ghost: smaller copy that appears on hover - shared styles in global.css */
  /* Hover state handled by parent component */

  .selected-work__visual-fallback {
    display: flex;
    align-items: flex-end;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 1rem;
    background: #030303;
  }
</style>
