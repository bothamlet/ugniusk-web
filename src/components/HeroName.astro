---
interface Props {
  firstName: string;
  lastName: string;
}

const { firstName, lastName } = Astro.props;
---

<h1 class="hero-name" aria-label={`${firstName} ${lastName}`}>
  <span class="hero-name__line hero-name__line--first" aria-hidden="true">{firstName}</span>
  <span class="hero-name__line hero-name__line--last" aria-hidden="true">{lastName}</span>
  <span class="hero-name__mobile" aria-hidden="true">
    {[firstName, lastName.slice(0, 5), lastName.slice(5)].map((word, index) => (
      <svg class:list={["hero-name__word", { "hero-name__word--accent": index > 0 }]}
        viewBox="0 -75 400 80" preserveAspectRatio="none" focusable="false">
        <text x="0" y="0">{word.toUpperCase()}</text>
      </svg>
    ))}
  </span>
</h1>

<script>
  // The hero name is sized to fill the width it sits in, and no more: the letters
  // keep their form and their spacing, only the font size changes. It is measured
  // rather than derived from a vw factor because the fit depends on the font's
  // metrics and on the scrollbar, and because the name has to land inside the
  // edge rather than across it.
  const heroName = document.querySelector<HTMLElement>(".hero-name");
  const heroSticky = document.querySelector<HTMLElement>(".hero-sticky");
  const heroLines = Array.from(
    document.querySelectorAll<HTMLElement>(".hero-name__line"),
  );

  const fitHeroName = () => {
    if (!heroName || !heroSticky || heroLines.length === 0) return;
    if (window.matchMedia("(max-width: 767px)").matches) {
      heroName.style.fontSize = "";
      const context = document.createElement("canvas").getContext("2d");
      const words = Array.from(heroName.querySelectorAll<SVGSVGElement>(".hero-name__word"));
      if (!context) return;
      context.font = `400 100px ${getComputedStyle(heroName).fontFamily}`;
      context.letterSpacing = "1px";
      for (const word of words) {
        const metrics = context.measureText(word.textContent?.trim().toUpperCase() || "");
        word.setAttribute("viewBox", [
          -metrics.actualBoundingBoxLeft,
          -metrics.actualBoundingBoxAscent,
          metrics.actualBoundingBoxLeft + metrics.actualBoundingBoxRight,
          metrics.actualBoundingBoxAscent + metrics.actualBoundingBoxDescent,
        ].join(" "));
      }
      return;
    }
    const available = heroSticky.clientWidth;
    if (!available) return;

    heroName.style.fontSize = ""; // back to the stylesheet value to measure
    const box = heroSticky.getBoundingClientRect();
    let right = 0;
    for (const line of heroLines) {
      right = Math.max(right, line.getBoundingClientRect().right - box.left);
    }
    if (right <= 0) return;

    const current = parseFloat(getComputedStyle(heroName).fontSize);
    // Everything across the two lines scales with the font size (the indent is
    // em, the condensing is a transform), so one measurement gives the fit.
    // 0.5% short of the edge: the glyph ink of the last letter sits just inside
    // its layout box, but the two are close enough on some renderers that a
    // flush fit can shave the final letter.
    let target = current * ((available * 0.995) / right);
    // Never push the second line out of the bottom of the hero: the block is
    // 1.40x the font size and starts 9.3% down.
    target = Math.min(target, heroSticky.clientHeight * 0.55);
    heroName.style.fontSize = `${target.toFixed(2)}px`;
  };

  if (heroName) {
    // Kick the wipe off only once the display font has loaded, so it runs over a
    // line whose width is final. A slow font must not leave the name hidden, so
    // there is a deadline as well as the promise; whichever lands second re-fits
    // against the real metrics.
    const reveal = () => {
      fitHeroName();
      heroName.classList.add("is-revealed");
    };
    document.fonts.ready.then(reveal);
    setTimeout(reveal, 2000);

    let queued = 0;
    window.addEventListener(
      "resize",
      () => {
        cancelAnimationFrame(queued);
        queued = requestAnimationFrame(fitHeroName);
      },
      { passive: true },
    );
  }
</script>

<style>
  .hero-name {
    position: absolute;
    inset: 0;
    margin: 0;
    overflow: visible;
    pointer-events: none;
    font-family: var(--font-display);
    /* Fills the width: 15.9vw is the point where the longest line, plus the 5%
       offset of the second line, reaches the right edge. No upper cap, so it
       keeps filling on wide displays; the max() only guards narrow phones. */
    font-size: max(2.75rem, 15.9vw);
    font-weight: 700;
    line-height: 0.76;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .hero-name__line {
    position: absolute;
    display: block;
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: inherit;
    font-weight: 700;
    /* Hidden until the display font is ready. The wipe is a percentage of the
       line's width, and the fallback font is a different width, so revealing
       while the font swaps in makes the wipe jump. */
    clip-path: inset(0 100% 0 0);
  }

  .hero-name.is-revealed .hero-name__line {
    animation: reveal-name 900ms cubic-bezier(0.4, 0, 0.2, 1) both;
    will-change: clip-path;
  }

  /* Without JS the name would stay clipped for good. */
  @media (scripting: none) {
    .hero-name__line {
      clip-path: none;
    }
  }

  .hero-name__line--first {
    top: 8%;
    left: -1%;
    z-index: 1;
    color: var(--color-paper);
  }

  .hero-name__line--last {
    top: 21%;
    left: 5%;
    z-index: 2;
    color: var(--color-accent);
    animation-delay: 120ms;
  }

  .hero-name__mobile {
    display: none;
  }

  @media (max-width: 767px) {
    .hero-name__line {
      display: none;
    }

    .hero-name__mobile {
      position: absolute;
      top: 47.5%;
      left: 9.5%;
      display: flex;
      flex-direction: column;
      transform: translateY(-50%);
    }

    .hero-name__word {
      display: block;
      overflow: visible;
      width: 63.8vw;
      height: min(16.32vw, 20.4svh);
      color: var(--color-paper);
    }

    .hero-name__word:nth-child(2) {
      width: 53.9vw;
      height: min(15.64vw, 19.55svh);
      margin-top: min(1.9vw, 2svh);
    }

    .hero-name__word:nth-child(3) {
      width: 41.4vw;
      height: min(16.15vw, 20.4svh);
      margin-top: min(1.6vw, 2svh);
    }

    .hero-name__word--accent {
      color: var(--color-accent);
    }

    .hero-name__word text {
      font-family: var(--font-display);
      font-size: 100px;
      font-weight: 400;
      letter-spacing: 1px;
      fill: currentColor;
      stroke: currentColor;
      stroke-width: 2px;
      stroke-linejoin: round;
      paint-order: stroke fill;
    }
  }

  @keyframes reveal-name {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0);
    }
  }

  @media (max-width: 767px) and (orientation: landscape) {
    .hero-name__line--last {
      top: calc(8% + 0.8em);
    }
  }

  @media (min-width: 768px) {
    .hero-name {
      inset: auto auto auto -0.02em;
      top: 9.3%;
      width: max-content;
      gap: 0;
      /* Fallback for the no-JS case and for the first paint; the script below
         measures and sets the exact size. The fit is 1 / 4.687 of the width for
         Archivo Black, so ~21.3vw is flush; this sits just under that so the
         name can never cross the edge before the script runs. */
      font-size: min(21.1vw, 57vh);
      font-weight: 700;
      line-height: 0.75;
      letter-spacing: -0.01em;
    }

    .hero-name__line {
      position: relative;
      top: auto;
      left: auto;
      width: max-content;
      font-family: var(--font-display);
      font-size: inherit;
      font-weight: 700;
      transform: scaleX(0.71);
      transform-origin: left top;
    }

    .hero-name__line--last {
      /* In em so the indent tracks the font size; this is the 175.68px it was at
         312px. A px or vw cap here would break the width fit on wide screens. */
      margin-left: 0.563em;
      margin-top: -0.1em;
    }
  }
</style>
