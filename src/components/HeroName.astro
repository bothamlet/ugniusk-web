---
interface Props {
  firstName: string;
  lastName: string;
}

const { firstName, lastName } = Astro.props;
---

<h1 class="hero-name" aria-label={`${firstName} ${lastName}`}>
  <span class="hero-name__line hero-name__line--first" aria-hidden="true">{firstName}</span>
  <span class="hero-name__line hero-name__line--last" aria-hidden="true">{lastName}</span>
</h1>

<script>
  // Kick the wipe off only once the display font has loaded, so it runs over a
  // line whose width is final. A slow font must not leave the name hidden, so
  // there is a deadline as well as the promise.
  const heroName = document.querySelector<HTMLElement>(".hero-name");
  if (heroName) {
    const reveal = () => heroName.classList.add("is-revealed");
    document.fonts.ready.then(reveal);
    setTimeout(reveal, 2000);
  }
</script>

<style>
  .hero-name {
    position: absolute;
    inset: 0;
    margin: 0;
    overflow: visible;
    pointer-events: none;
    font-family: var(--font-display);
    /* Fills the width: 15.9vw is the point where the longest line, plus the 5%
       offset of the second line, reaches the right edge. No upper cap, so it
       keeps filling on wide displays; the max() only guards narrow phones. */
    font-size: max(2.75rem, 15.9vw);
    font-weight: 700;
    line-height: 0.76;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .hero-name__line {
    position: absolute;
    display: block;
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: inherit;
    font-weight: 700;
    /* Hidden until the display font is ready. The wipe is a percentage of the
       line's width, and the fallback font is a different width, so revealing
       while the font swaps in makes the wipe jump. */
    clip-path: inset(0 100% 0 0);
  }

  .hero-name.is-revealed .hero-name__line {
    animation: reveal-name 900ms cubic-bezier(0.4, 0, 0.2, 1) both;
    will-change: clip-path;
  }

  /* Without JS the name would stay clipped for good. */
  @media (scripting: none) {
    .hero-name__line {
      clip-path: none;
    }
  }

  .hero-name__line--first {
    top: 8%;
    left: -1%;
    z-index: 1;
    color: var(--color-paper);
  }

  .hero-name__line--last {
    top: 21%;
    left: 5%;
    z-index: 2;
    color: var(--color-accent);
    animation-delay: 120ms;
  }

  @keyframes reveal-name {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0);
    }
  }

  @media (min-width: 768px) {
    .hero-name {
      inset: auto auto auto -0.02em;
      top: 9.3%;
      width: max-content;
      gap: 0;
      /* Sized to span the viewport width: at 21.67vw the two lines measure
         101.6% edge to edge, which is the full-bleed the design already had at
         1440px. The ceiling was 312px, which froze the name at roughly half the
         width on a 2880px screen. The vh term only engages on screens so wide
         and short that filling the width would push the second line off the
         bottom: the block is 1.40x its font size and starts 9.3% down. */
      font-size: min(21.67vw, 61vh);
      font-weight: 700;
      line-height: 0.75;
      letter-spacing: -0.01em;
    }

    .hero-name__line {
      position: relative;
      top: auto;
      left: auto;
      width: max-content;
      font-family: var(--font-display);
      font-size: inherit;
      font-weight: 700;
      transform: scaleX(0.71);
      transform-origin: left top;
    }

    .hero-name__line--last {
      /* In em so the indent tracks the font size; this is the 175.68px it was at
         312px. A px or vw cap here would break the width fit on wide screens. */
      margin-left: 0.563em;
      margin-top: -0.1em;
    }
  }
</style>
