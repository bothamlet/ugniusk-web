<dialog class="image-viewer" aria-labelledby="image-viewer-title" data-lenis-prevent>
  <header class="image-viewer__header">
    <h2 id="image-viewer-title">Project image</h2>
    <button class="image-viewer__close" type="button" aria-label="Close image viewer" autofocus>Close ×</button>
  </header>
  <div class="image-viewer__tools" aria-label="Image zoom controls">
    <button type="button" data-zoom-out aria-label="Zoom out">−</button>
    <button type="button" data-zoom-fit>Fit image</button>
    <button type="button" data-zoom-in aria-label="Zoom in">+</button>
    <a class="image-viewer__original" target="_blank" rel="noopener noreferrer">Open original ↗</a>
  </div>
  <div class="image-viewer__viewport" tabindex="0" aria-label="Image; scroll to inspect when zoomed" data-lenis-prevent>
    <img class="image-viewer__image" alt="" />
  </div>
  <p class="image-viewer__caption"></p>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.image-viewer');
  if (dialog) {
    const viewport = dialog.querySelector<HTMLElement>('.image-viewer__viewport')!;
    const image = dialog.querySelector<HTMLImageElement>('.image-viewer__image')!;
    const caption = dialog.querySelector<HTMLElement>('.image-viewer__caption')!;
    const original = dialog.querySelector<HTMLAnchorElement>('.image-viewer__original')!;
    const zoomIn = dialog.querySelector<HTMLButtonElement>('[data-zoom-in]')!;
    const zoomOut = dialog.querySelector<HTMLButtonElement>('[data-zoom-out]')!;
    let zoom = 1;
    let fitWidth = 0;

    const measure = () => {
      if (!dialog.open || !image.naturalWidth) return;
      fitWidth = Math.min(image.naturalWidth, Math.max(1, viewport.clientWidth - 32),
        Math.max(1, viewport.clientHeight - 32) * image.naturalWidth / image.naturalHeight);
      image.style.width = `${fitWidth * zoom}px`;
      zoomOut.disabled = zoom === 1;
      zoomIn.disabled = zoom === 4;
    };
    const setZoom = (value: number) => {
      const previous = image.getBoundingClientRect();
      const view = viewport.getBoundingClientRect();
      const centerX = previous.width <= viewport.clientWidth - 32 ? 0.5 :
        (view.left + viewport.clientWidth / 2 - previous.left) / previous.width;
      const centerY = previous.height <= viewport.clientHeight - 32 ? 0.5 :
        (view.top + viewport.clientHeight / 2 - previous.top) / previous.height;
      zoom = Math.max(1, Math.min(4, value));
      measure();
      if (zoom === 1) {
        viewport.scrollTo(0, 0);
      } else {
        const current = image.getBoundingClientRect();
        viewport.scrollTo({
          left: viewport.scrollLeft + current.left - view.left + current.width * centerX - viewport.clientWidth / 2,
          top: viewport.scrollTop + current.top - view.top + current.height * centerY - viewport.clientHeight / 2,
        });
      }
    };
    image.addEventListener('load', measure);
    zoomIn.addEventListener('click', () => setZoom(zoom + 1));
    zoomOut.addEventListener('click', () => setZoom(zoom - 1));
    dialog.querySelector('[data-zoom-fit]')!.addEventListener('click', () => setZoom(1));
    dialog.querySelector('.image-viewer__close')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab') return;
      const controls = [...dialog.querySelectorAll<HTMLElement>('button:not(:disabled), a[href], [tabindex="0"]')];
      const first = controls[0];
      const last = controls[controls.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('image-viewer-active');
      window.siteMotion?.lenis.start();
    });
    new ResizeObserver(measure).observe(viewport);
    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element) || !(event instanceof MouseEvent)) return;
      const link = event.target.closest<HTMLAnchorElement>('[data-image-viewer]');
      if (!link || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      if (typeof dialog.showModal !== 'function') return;
      event.preventDefault();
      zoom = 1;
      image.alt = link.dataset.imageAlt || 'Project image';
      caption.textContent = image.alt;
      image.src = link.href;
      original.href = link.href;
      dialog.showModal();
      viewport.scrollTo(0, 0);
      document.documentElement.classList.add('image-viewer-active');
      window.siteMotion?.lenis.stop();
      measure();
    });
  }
</script>

<style is:global>
  html.image-viewer-active { overflow: hidden; }
  .image-viewer {
    position: fixed;
    inset: 0;
    margin: auto;
    width: min(96vw, 76rem);
    height: min(92dvh, 60rem);
    max-width: 100%;
    max-height: 100dvh;
    padding: 0;
    border: 1px solid #454545;
    background: #101010;
    color: #f4f3f0;
    font-family: var(--font-mono);
  }
  .image-viewer[open] { display: flex; flex-direction: column; }
  .image-viewer::backdrop { background: rgb(0 0 0 / 0.85); }
  .image-viewer__header, .image-viewer__tools {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    padding: 0.5rem 1rem;
  }
  .image-viewer__header { justify-content: space-between; }
  .image-viewer__header h2 { font-size: 1rem; }
  .image-viewer button, .image-viewer__original {
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid #595959;
    background: #202020;
    color: #f4f3f0;
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }
  .image-viewer button:disabled { opacity: 0.4; cursor: default; }
  .image-viewer button:focus-visible, .image-viewer a:focus-visible,
  .image-viewer__viewport:focus-visible { outline: 2px solid var(--color-accent-soft); outline-offset: -2px; }
  .image-viewer__original { display: inline-flex; align-items: center; margin-left: auto; }
  .image-viewer__viewport {
    flex: 1;
    min-height: 0;
    overflow: auto;
    overscroll-behavior: contain;
    padding: 1rem;
    background: #070707;
  }
  .image-viewer__image { display: block; max-width: none; height: auto; margin-inline: auto; transition-property: none; }
  .image-viewer__caption { padding: 0.75rem 1rem; font-size: 0.75rem; line-height: 1.5; }
  @media (max-width: 900px) {
    .image-viewer { width: 100%; height: 100dvh; border: 0; }
    .image-viewer__header { padding-top: max(0.5rem, env(safe-area-inset-top)); }
    .image-viewer__caption { padding-bottom: max(0.75rem, env(safe-area-inset-bottom)); }
  }
</style>
